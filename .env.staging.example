# Copy to .env.staging on the staging host. Replace every placeholder.
# Keep this file outside source control and restrict permissions to the deploy user.
POSTGRES_DB=timedrop_staging
POSTGRES_USER=timedrop_staging
# Use a long URL-safe alphanumeric password because Compose embeds it in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_PASSWORD
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
CORS_ORIGINS=https://staging.example.com
TRUSTED_HOSTS=staging.example.com,127.0.0.1
NOTIFICATION_FROM_EMAIL=TimeDrop Staging <staging@example.com>
ROUTE_PROVIDER_USER_AGENT=TimeDrop-Staging/1.0 (contact: ops@example.com)

# Optional integrations remain disabled until credentials and templates are configured.
RESEND_API_KEY=
MSG91_AUTH_KEY=
MSG91_FLOW_TEMPLATE_ID=
MSG91_OTP_TEMPLATE_ID=
SMS_NOTIFICATIONS_ENABLED=false
ROUTE_MAPPING_ENABLED=false

NOTIFICATION_WORKER_POLL_SECONDS=5
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_DELIVERY_LEASE_SECONDS=300
NOTIFICATION_RETRY_BASE_SECONDS=5
NOTIFICATION_RETRY_MAX_SECONDS=300
WEB_PORT=8080
