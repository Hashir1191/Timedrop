APP_NAME=TimeDrop API
APP_ENV=development
DATABASE_URL=sqlite:///./timedrop.db
POSTGRES_DB=timedrop
POSTGRES_USER=timedrop_user
POSTGRES_PASSWORD=change-this-local-docker-password
POSTGRES_PORT=5432
API_PORT=8000
SECRET_KEY=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=TimeDrop <onboarding@resend.dev>
NOTIFICATION_WORKER_POLL_SECONDS=5
NOTIFICATION_MAX_ATTEMPTS=5

# MSG91 transactional SMS
MSG91_AUTH_KEY=
MSG91_FLOW_TEMPLATE_ID=
SMS_NOTIFICATIONS_ENABLED=false

# MSG91 OTP template from the OTP section (must contain ##OTP##)
MSG91_OTP_TEMPLATE_ID=

# Local-only fallback; production mode always requires MSG91 OTP credentials.
PHONE_OTP_EXPOSE_IN_DEVELOPMENT=true
PHONE_OTP_EXPIRE_MINUTES=5
PHONE_OTP_MAX_ATTEMPTS=5

# Optional map-based route planning (disabled until explicitly enabled).
# When enabled, full delivery addresses are sent to the configured geocoder.
ROUTE_MAPPING_ENABLED=false
ROUTE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
ROUTE_ROUTER_URL=https://router.project-osrm.org
# Replace with a descriptive application identifier and a monitored contact email.
ROUTE_PROVIDER_USER_AGENT=TimeDrop/1.0 (route-planning; contact: ops@example.com)
ROUTE_GEOCODE_TIMEOUT_SECONDS=8
