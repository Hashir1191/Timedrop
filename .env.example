# Copy this file to .env. Never commit .env or production secrets.
APP_NAME=TimeDrop API
APP_ENV=development

# Local non-Docker development uses SQLite.
DATABASE_URL=sqlite:///./timedrop.db

# Docker Compose PostgreSQL settings (development defaults only).
POSTGRES_DB=timedrop
POSTGRES_USER=timedrop_user
POSTGRES_PASSWORD=change-this-local-docker-password
POSTGRES_PORT=5432
API_PORT=8000

# Generate a unique random value of at least 32 characters for production.
SECRET_KEY=replace-this-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Comma-separated browser origins; no trailing slash.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Resend transactional email (leave empty to keep outbound email disabled)
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL=TimeDrop <onboarding@resend.dev>
NOTIFICATION_WORKER_POLL_SECONDS=5
NOTIFICATION_MAX_ATTEMPTS=5

# MSG91 transactional SMS. Keep disabled until the Flow is DLT-approved.
MSG91_AUTH_KEY=
MSG91_FLOW_TEMPLATE_ID=
SMS_NOTIFICATIONS_ENABLED=false
# The MSG91 Flow must define VAR1 (notification title) and VAR2 (notification message).

# Development-only OTP response; never enable in production
PHONE_OTP_EXPOSE_IN_DEVELOPMENT=true
PHONE_OTP_EXPIRE_MINUTES=5
PHONE_OTP_MAX_ATTEMPTS=5
